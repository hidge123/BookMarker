{
  "manifest_version": 3,
  "name": "BookMarker · 书签工作台",
  "version": "1.1.0",
  "description": "本地书签管理、回收站、版本备份与网页可达性检测。",
  "minimum_chrome_version": "134",
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "optional_permissions": [
    "webRequest"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 BookMarker"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
